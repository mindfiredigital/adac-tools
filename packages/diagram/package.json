{
  "name": "@mindfiredigital/adac-diagram",
  "version": "0.1.0",
  "description": "Generate architecture diagrams from ADAC YAML: the adac CLI and a JavaScript API",
  "author": "Mindfire Digital",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "adac": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mindfiredigital/adac-tools.git",
    "directory": "packages/diagram"
  },
  "keywords": [
    "adac",
    "aws",
    "diagram",
    "elkjs",
    "architecture",
    "cloud"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "elkjs": "^0.11.1",
    "fs-extra": "^11.3.3"
  },
  "peerDependencies": {
    "@mindfiredigital/adac-icons-aws": "*"
  },
  "peerDependenciesMeta": {
    "@mindfiredigital/adac-icons-aws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mindfiredigital/adac-cli": "workspace:*",
    "@mindfiredigital/adac-compliance": "workspace:*",
    "@mindfiredigital/adac-core": "workspace:*",
    "@mindfiredigital/adac-cost": "workspace:*",
    "@mindfiredigital/adac-export-cloudformation": "workspace:*",
    "@mindfiredigital/adac-export-k8s": "workspace:*",
    "@mindfiredigital/adac-export-terraform": "workspace:*",
    "@mindfiredigital/adac-icons-aws": "workspace:*",
    "@mindfiredigital/adac-icons-azure": "workspace:*",
    "@mindfiredigital/adac-icons-gcp": "workspace:*",
    "@mindfiredigital/adac-layout-core": "workspace:*",
    "@mindfiredigital/adac-layout-elk": "workspace:*",
    "@mindfiredigital/adac-parser": "workspace:*",
    "@mindfiredigital/adac-validator": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.3",
    "tsup": "^8.3.5",
    "vitest": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18"
  }
}
