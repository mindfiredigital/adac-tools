{
  "name": "adac-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "ADAC - AWS Diagram Generator Monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "cli": "node packages/diagram/dist/cli.js",
    "setup:icons": "pnpm --filter @mindfiredigital/adac-icons-aws run setup-icons && pnpm --filter @mindfiredigital/adac-icons-gcp run setup-icons && pnpm --filter @mindfiredigital/adac-icons-azure run setup-icons",
    "prerelease:pack": "pnpm setup:icons && pnpm build",
    "release:pack": "node scripts/pack-release.js",
    "release:publish": "node scripts/publish-packages.mjs",
    "release:publish:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "release:setup": "node scripts/setup-publish-config.mjs",
    "changeset:autogenerate": "node .github/changeset-autogenerate.mjs",
    "changeset:version": "node .github/changeset-version.js"
  },
  "keywords": [
    "adac",
    "aws",
    "diagram"
  ],
  "author": "Mindfire Digital",
  "license": "Apache-2.0",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "commander": "^14.0.3",
    "elkjs": "^0.11.1",
    "express": "^5.2.1",
    "fs-extra": "^11.3.6",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vercel/node": "^5.8.24",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^8.57.1",
    "eslint-plugin-unicorn": "51.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
